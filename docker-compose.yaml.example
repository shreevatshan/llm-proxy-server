services:
  llm-proxy-server:
    image: shreevatshan/llm-proxy-server:latest
    container_name: llm-proxy-server
    ports:
      - "11440:11440"  # OpenAI API
      - "11439:11439"  # Azure OpenAI API
      - "2027:2027"    # Anthropic API
      - "8765:8765"    # Management panel
    volumes:
      # Database persistence - the container will create this directory with proper permissions
      - ./data:/llm-proxy-server/data
    ulimits:
      nofile:
        soft: 65535
        hard: 65535
    environment:
      # Python Configuration
      - PYTHONUNBUFFERED=1
      # Database Configuration
      - DATABASE_URL=sqlite+aiosqlite:///./data/llm_proxy.db
      # JWT Authentication — REQUIRED: the server refuses to start with this
      # placeholder. Generate a real key with:
      #   python -c "import secrets; print(secrets.token_urlsafe(48))"
      - JWT_SECRET_KEY=your-secret-key-change-this-in-production
      # Cookies default to Secure (HTTPS-only). Set to false for plain-HTTP
      # deployments, or browsers will drop the auth/CSRF cookies and login
      # will silently loop on non-localhost hostnames.
      - COOKIE_SECURE=false
      # Server Configuration
      - LLMPROXY_HOST=0.0.0.0
      - LLMPROXY_DOMAIN=localhost
      - OPENAI_SERVER_PORT=11440
      - AZURE_OPENAI_SERVER_PORT=11439
      - ANTHROPIC_SERVER_PORT=2027
      - MANAGEMENT_SERVER_PORT=8765
      # Admin Configuration
      - LLMPROXY_ADMIN_ENABLED=true
      - LLMPROXY_ADMIN_USERNAME=admin
      - LLMPROXY_ADMIN_EMAIL=admin@localhost.com
      # REQUIRED: the server refuses to start with this placeholder password.
      - LLMPROXY_ADMIN_PASSWORD=admin123
      # Zoho OAuth Configuration
      # Base URL is automatically detected from https://accounts.zoho.com/oauth/serverinfo
      #- ZOHO_CLIENT_ID=your-zoho-client-id
      #- ZOHO_CLIENT_SECRET=your-zoho-client-secret
      # OpenTelemetry Tracing Configuration (uncomment to enable)
      #- OTEL_EXPORTER_OTLP_ENDPOINT=https://localhost:4318
      #- OTEL_SERVICE_NAME=llm-proxy-server
      #- OTEL_EXPORTER_OTLP_HEADERS=api-key=*********
      # Timezone Configuration
      - TIMEZONE=Asia/Kolkata
    restart: unless-stopped
    healthcheck:
      # A failing healthcheck only flips the container to "unhealthy" in plain
      # Compose — it does NOT trigger `restart: unless-stopped` (that fires on
      # process exit only; acting on health status is Swarm-only). So the probe
      # itself SIGKILLs PID 1 after 3 consecutive failures, turning a hang into a
      # process exit that the restart policy then restarts. The /tmp counter is
      # reset on every success so a single transient blip won't trip it.
      # timeout=5 + raise_for_status() make a slow or 5xx response count as a
      # failure (bare requests.get() ignores status and can block forever).
      test:
        - CMD-SHELL
        - |
          python - <<'PY'
          import requests, os, signal
          f = '/tmp/health_fail'
          try:
              requests.get('http://localhost:8765/health', timeout=5).raise_for_status()
              open(f, 'w').write('0')
          except Exception:
              try:
                  n = int(open(f).read() or 0)
              except Exception:
                  n = 0
              n += 1
              open(f, 'w').write(str(n))
              if n >= 3:
                  os.kill(1, signal.SIGKILL)
              raise SystemExit(1)
          PY
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    networks:
      - llm-proxy-network

networks:
  llm-proxy-network:
    driver: bridge

services:
  llm-proxy-server:
    image: shreevatshan/llm-proxy-server:latest
    container_name: llm-proxy-server
    ports:
      - "11440:11440"  # OpenAI API
      - "11439:11439"  # Azure OpenAI API
      - "2027:2027"    # Anthropic API
      - "8765:8765"    # Management panel
    volumes:
      # Database persistence - the container will create this directory with proper permissions
      - ./data:/llm-proxy-server/data
    ulimits:
      nofile:
        soft: 65535
        hard: 65535
    environment:
      # Python Configuration
      - PYTHONUNBUFFERED=1
      # Database Configuration
      - DATABASE_URL=sqlite+aiosqlite:///./data/llm_proxy.db
      # Async connection pool (defaults shown). SQLite allows one writer, so
      # larger pools mostly add sessions waiting on the write lock.
      # - DATABASE_POOL_SIZE=5
      # - DATABASE_MAX_OVERFLOW=10
      # - DATABASE_POOL_TIMEOUT=30
      # JWT Authentication — REQUIRED: the server refuses to start with this
      # placeholder. Generate a real key with:
      #   python -c "import secrets; print(secrets.token_urlsafe(48))"
      - JWT_SECRET_KEY=your-secret-key-change-this-in-production
      # Cookies default to Secure (HTTPS-only). Set to false for plain-HTTP
      # deployments, or browsers will drop the auth/CSRF cookies and login
      # will silently loop on non-localhost hostnames.
      - COOKIE_SECURE=false
      # Server Configuration
      - LLMPROXY_HOST=0.0.0.0
      - LLMPROXY_DOMAIN=localhost
      - OPENAI_SERVER_PORT=11440
      - AZURE_OPENAI_SERVER_PORT=11439
      - ANTHROPIC_SERVER_PORT=2027
      - MANAGEMENT_SERVER_PORT=8765
      # Admin Configuration
      - LLMPROXY_ADMIN_ENABLED=true
      - LLMPROXY_ADMIN_USERNAME=admin
      - LLMPROXY_ADMIN_EMAIL=admin@localhost.com
      # REQUIRED: the server refuses to start with this placeholder password.
      - LLMPROXY_ADMIN_PASSWORD=admin123
      # Zoho OAuth Configuration
      # Base URL is automatically detected from https://accounts.zoho.com/oauth/serverinfo
      #- ZOHO_CLIENT_ID=your-zoho-client-id
      #- ZOHO_CLIENT_SECRET=your-zoho-client-secret
      # OpenTelemetry Tracing Configuration (uncomment to enable)
      #- OTEL_EXPORTER_OTLP_ENDPOINT=https://localhost:4318
      #- OTEL_SERVICE_NAME=llm-proxy-server
      #- OTEL_EXPORTER_OTLP_HEADERS=api-key=*********
      # Timezone Configuration
      - TIMEZONE=Asia/Kolkata
    restart: unless-stopped
    healthcheck:
      # A failing healthcheck only flips the container to "unhealthy" in plain
      # Compose — it does NOT trigger `restart: unless-stopped` (that fires on
      # process exit only; acting on health status is Swarm-only). So the probe
      # itself SIGKILLs PID 1 after 3 consecutive failures, turning a hang into a
      # process exit that the restart policy then restarts. The /tmp counter is
      # reset on every success so a single transient blip won't trip it.
      # timeout=5 + raise_for_status() make a slow or 5xx response count as a
      # failure (bare requests.get() ignores status and can block forever).
      test:
        - CMD-SHELL
        - |
          python - <<'PY'
          import requests, os, signal
          f = '/tmp/health_fail'
          try:
              requests.get('http://localhost:8765/health', timeout=5).raise_for_status()
              open(f, 'w').write('0')
          except Exception:
              try:
                  n = int(open(f).read() or 0)
              except Exception:
                  n = 0
              n += 1
              open(f, 'w').write(str(n))
              if n >= 3:
                  os.kill(1, signal.SIGKILL)
              raise SystemExit(1)
          PY
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    networks:
      - llm-proxy-network

  # SearXNG metasearch engine used by the proxy's web search interception.
  # Configure it in Admin -> Web Search with base URL http://searxng:8080
  # (the service name on llm-proxy-network; no host port is published).
  searxng:
    image: searxng/searxng:latest
    container_name: searxng
    configs:
      # Enables format=json, which the proxy requires (otherwise HTTP 403).
      - source: searxng_settings
        target: /etc/searxng/settings.yml
    environment:
      # Bind IPv4; the default (::) fails on hosts with IPv6 disabled.
      - GRANIAN_HOST=0.0.0.0
      # Only reachable on the internal compose network, so the bot limiter
      # (which would also need a Valkey/Redis service) is off.
      - SEARXNG_LIMITER=false
      - SEARXNG_PUBLIC_INSTANCE=false
      - SEARXNG_IMAGE_PROXY=false
      # REQUIRED: SearXNG refuses to start without a real secret. Generate one with:
      #   python -c "import secrets; print(secrets.token_hex(32))"
      - SEARXNG_SECRET=change-this-to-a-random-secret
    # Uncomment to reach SearXNG from the host for debugging:
    # ports:
    #   - "8080:8080"
    restart: unless-stopped
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    networks:
      - llm-proxy-network

  # 4get metasearch engine; the alternative web-search backend.
  # Configure it in Admin -> Web Search with base URL http://fourget
  # (the service name on llm-proxy-network; no host port is published).
  # BOT_PROTECTION and API_ENABLED are deliberately not set: the image already
  # defaults to captcha-off and API-on, and gen_config.php writes env overrides
  # as quoted PHP strings, which would break those constants' comparisons.
  fourget:
    image: luuul/4get:latest
    container_name: fourget
    environment:
      - FOURGET_PROTO=http
      - FOURGET_SERVER_NAME=fourget
    # Uncomment to reach 4get from the host for debugging:
    # ports:
    #   - "8082:80"
    restart: unless-stopped
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    networks:
      - llm-proxy-network

networks:
  llm-proxy-network:
    driver: bridge

configs:
  # SearXNG settings for the proxy's web search interception, mounted at
  # /etc/searxng/settings.yml (inline content needs Docker Compose 2.23+).
  # Only overrides are listed; everything else comes from SearXNG's defaults.
  # server.* settings are set through environment variables on the service.
  searxng_settings:
    content: |
      use_default_settings:
        engines:
          # wikidata's startup query is often rejected (HTTP 403); when its init
          # fails, SearXNG errors on every "general" search ("search error").
          remove:
            - wikidata

      outgoing:
        # Per-engine timeout. The 3s default is too short for Brave, which then
        # drops out of the results; keep it below the proxy's web search timeout
        # (Admin -> Web Search, 10s by default) so SearXNG answers first.
        request_timeout: 5.0
        max_request_timeout: 8.0

      search:
        safe_search: 1
        # The proxy calls /search?format=json; without "json" here SearXNG answers 403.
        formats:
          - html
          - json
